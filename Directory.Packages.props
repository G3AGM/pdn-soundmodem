<Project>
  <ItemGroup>
    <!-- Serial / IO -->
    <PackageVersion Include="System.IO.Ports" Version="10.0.11" />

    <!-- FlexRadio 6000-series client (lifted out of this repo; AGPL-3.0-or-later). The same
         licence as this repo; see LICENSING.md and PROVENANCE.md. -->
    <PackageVersion Include="M0LTE.Flex" Version="0.15.1" />
    <PackageVersion Include="M0LTE.Radio.Audio" Version="0.1.1" />
    <PackageVersion Include="M0LTE.Fec" Version="0.3.0" />
    <PackageVersion Include="M0LTE.Il2p" Version="0.3.0" />
    <PackageVersion Include="M0LTE.Ardop" Version="0.6.0" />
    <PackageVersion Include="M0LTE.Pocsag" Version="0.1.0" />

    <!-- DSP primitives (FFT/FIR/decimator/upsampler/frequency-shifter/spectrum/occupied-bandwidth
         and, from 0.2.0, SSB demodulation from complex baseband), the OFDM modem
         (Cf/OfdmModulator/OfdmDemodulator/Datac*), and the LDPC codec - each lifted out of this
         repo into its own package. -->
    <PackageVersion Include="M0LTE.Dsp" Version="0.2.1" />
    <!-- The FM link model, lifted out of this repository's test project so that the modems
         measured through it - here and in the out-of-tree ones - share one definition. -->
    <PackageVersion Include="M0LTE.FmChannel" Version="0.7.0" />
    <PackageVersion Include="M0LTE.FecLdpc" Version="0.1.0" />
    <PackageVersion Include="M0LTE.Ofdm" Version="0.1.0" />
    <!-- The Tait CCDI driver, for OFDM-FM carrier sense taken from the radio's own squelch and
         signal-strength meter rather than inferred from the audio a receiver produces. AGPL-3.0,
         the same licence as this repo; see CLAUDE.md, Licence rules.
         Only reached when a station opts in by writing ofdm-fm.station.json, so a station without
         that file never constructs it and never opens a serial port. -->
    <PackageVersion Include="Packet.Radio.Tait" Version="0.33.0" />

    <!-- WASAPI capture/render and endpoint volume for Packet.SoundModem.Windows. MIT, so
         GPL-compatible per CLAUDE.md's licence rules; only the Windows library references it. -->
    <PackageVersion Include="NAudio.Wasapi" Version="2.2.1" />

    <!-- Pure-managed zstd port for the ka9q_ubersdr / UberSDR IQ path (pcm-zstd WebSocket
         frames). MIT, so GPL-compatible per CLAUDE.md's licence rules. It was dev-tooling-only
         while the only consumer was the capture tool; the shipped package now carries the
         `ubersdr:` receive device, so the wire decoder - and this - moved into the core. -->
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />

    <!-- Dev tooling only (tools/Packet.SoundModem.NinoCompare) - the NinoTNC comparison harness.
         All MIT-licensed; not referenced by the shipped pdn-soundmodem package. -->
    <!-- Frame log store. MIT (and SQLitePCLRaw's bundled SQLite is public domain), so
         GPL-compatible per CLAUDE.md's licence rules. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pinned above what Microsoft.Data.Sqlite drags in: its transitive
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 carries GHSA-2m69-gcr7-jv3q (a vulnerable bundled
         SQLite), which this repo's NuGet audit correctly refuses to build. The advisory covers
         <= 2.1.11; this is the patched line. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <!-- AX.25 codec and link observer from packet.net. AGPL-3.0-or-later since 0.26.0 (0.23.0
         was the last MIT release), the same licence as this repo, like M0LTE.Flex above.
         Packet.Core moves with it: each Packet.Ax25 depends on the matching version. -->
    <PackageVersion Include="Packet.Ax25" Version="0.37.0" />
    <PackageVersion Include="Packet.Core" Version="0.37.0" />

    <!-- For the built-in mailcast receiver (the "mailcast" section): pdn-mailcast's core (the on-air
         frame format, bulletins, the directory and timetable and the receiver's store;
         AGPL-3.0-only, which combines with this repo's AGPL-3.0-or-later under AGPL-3.0, and brings
         M0LTE.RaptorQ with it) and FBB B1F forwarding from pdn-fbb (AGPL-3.0-or-later). See
         LICENSING.md. -->
    <PackageVersion Include="Packet.Mailcast" Version="0.4.3" />
    <PackageVersion Include="Packet.Fbb" Version="0.1.0" />

    <!-- Testing - xUnit v3 with Microsoft Testing Platform (MTP) runner -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.2.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>
</Project>
